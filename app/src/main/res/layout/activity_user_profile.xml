<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1C1C1C">

    <!-- ── HEADER ── -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:background="#2E2346"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_back"
            android:background="@drawable/bg_circle_purple"
            android:contentDescription="Geri"
            android:padding="6dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            app:tint="#FFFFFF" />

        <!-- Avatar + İsim merkezi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_circle_purple">
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_profile"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_title"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPlanBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="2dp"
                android:text="@string/plan_free_badge"
                android:textColor="#FFC107"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_rounded_dark_gray" />
        </LinearLayout>
    </RelativeLayout>

    <!-- ── SCROLL ALANI ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── ÜYELİK KARTI ── -->
            <LinearLayout
                android:id="@+id/cardSubscription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_premium"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <!-- Başlık -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_crown"
                        android:layout_marginEnd="8dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/subscription_info_title"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvActiveStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_active"
                        android:textColor="#4CAF50"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#4D4A5A"
                    android:layout_marginBottom="12dp" />

                <!-- Plan -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/label_plan"
                        android:textColor="#AAAAAA" android:textSize="13sp" />
                    <TextView android:id="@+id/tvPlanName" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="—"
                        android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- Başlangıç -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/label_start_date"
                        android:textColor="#AAAAAA" android:textSize="13sp" />
                    <TextView android:id="@+id/tvStartDate" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="—"
                        android:textColor="#FFFFFF" android:textSize="13sp" />
                </LinearLayout>

                <!-- Bitiş -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/label_end_date"
                        android:textColor="#AAAAAA" android:textSize="13sp" />
                    <TextView android:id="@+id/tvEndDate" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="—"
                        android:textColor="#FFFFFF" android:textSize="13sp" />
                </LinearLayout>

                <!-- Kalan -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/label_remaining_days"
                        android:textColor="#AAAAAA" android:textSize="13sp" />
                    <TextView android:id="@+id/tvRemainingDays" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="—"
                        android:textColor="#FFC107" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- Hız Limiti -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/label_speed_limit"
                        android:textColor="#AAAAAA" android:textSize="13sp" />
                    <TextView android:id="@+id/tvSpeedLimit" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="—"
                        android:textColor="#FFFFFF" android:textSize="13sp" />
                </LinearLayout>

                <!-- Premium yükselt butonu (Free kullanıcı için) -->
                <Button
                    android:id="@+id/btnUpgrade"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/upgrade_to_premium"
                    android:textColor="#1C1C1C"
                    android:textSize="13sp"
                    android:backgroundTint="#FFC107"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ── CİHAZLARIM KARTI ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_dark_gray"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_settings"
                        android:layout_marginEnd="8dp"
                        app:tint="#BB86FC" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/my_devices_title"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvDeviceCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#AAAAAA"
                        android:textSize="12sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#3E3E3E"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/llDevices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ── SON BAĞLANTILAR KARTI ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_dark_gray"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_time"
                        android:layout_marginEnd="8dp"
                        app:tint="#BB86FC" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/recent_connections_title"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#3E3E3E"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/llLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ── ÇIKIŞ YAP ── -->
            <Button
                android:id="@+id/buttonLogout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/btn_logout"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:backgroundTint="#C62828"
                android:layout_marginBottom="8dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
