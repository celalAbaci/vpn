<?xml version="1.0" encoding="utf-8"?>
<!--
  Kök öğe olarak RelativeLayout kullanmak, geri butonunu
  kaydırılabilir içeriğin üzerine, sol üste sabitlemeyi sağlar.
  Ancak, orijinal yapınıza sadık kalarak LinearLayout'u kullanacağız.
  Geri butonunun en üste eklendiğini unutmayın.
  app:tint özelliğini kullanmak için 'xmlns:app' ad alanını ekledik.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1C1C"
    android:padding="24dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!--
          İstediğiniz geri butonu.
          layout_gravity="top|start", bu öğeyi ebeveyninin
          (LinearLayout) 'center_horizontal' gravity ayarından bağımsız olarak
          sol üste hizalar.
        -->
        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/circle_left_regular_full"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:layout_gravity="top|start"
            android:scaleType="fitCenter"
            android:padding="4dp"
            app:tint="#FFFFFF"
            />

        <TextView
            android:id="@+id/helpText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/help_message"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/contactButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_contact_support"
            android:padding="12dp"
            android:backgroundTint="#6200EE"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>
