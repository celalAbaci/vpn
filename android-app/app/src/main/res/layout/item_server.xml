<?xml version="1.0" encoding="utf-8"?>
<!-- Bu dosya, ServerSelectionActivity'deki her bir sunucu satırını temsil eder -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_dark_gray_2"
    android:padding="16dp"
    android:layout_marginBottom="10dp">

    <!-- Bayrak veya Ülke Kodu -->
    <TextView
        android:id="@+id/countryCodeTextView"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_circle_dark_gray"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="TR" />

    <!-- Sunucu Adı (Ülke Adı) -->
    <TextView
        android:id="@+id/serverNameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/countryCodeTextView"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        tools:text="Türkiye - İstanbul" />

    <!-- Premium İkonu (Model desteklemediği için varsayılan olarak GONE) -->
    <ImageView
        android:id="@+id/premiumIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_crown"
        android:layout_toStartOf="@id/pingTextView"
        android:layout_centerVertical="true"
        android:layout_marginEnd="8dp"
        android:visibility="gone"
        tools:visibility="visible"/>

    <!-- Premium Yazısı (Model desteklemediği için varsayılan olarak GONE) -->
    <TextView
        android:id="@+id/premiumTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Premium"
        android:textColor="@color/premium_yellow"
        android:textSize="12sp"
        android:layout_toStartOf="@id/premiumIcon"
        android:layout_centerVertical="true"
        android:layout_marginEnd="4dp"
        android:visibility="gone"
        tools:visibility="visible"/>


    <!-- Ping / Yük Durumu -->
    <TextView
        android:id="@+id/pingTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@id/statusIndicator"
        android:layout_centerVertical="true"
        android:layout_marginEnd="8dp"
        android:textColor="@color/gray_light"
        android:textSize="14sp"
        tools:text="15% Yük" />

    <!-- Sinyal/Yük Göstergesi -->
    <ImageView
        android:id="@+id/statusIndicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:src="@drawable/ic_signal_strong"
        tools:src="@drawable/ic_signal_medium" />

</RelativeLayout>
