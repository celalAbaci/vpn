<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.abacicelal.supervpn_project">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required for WireGuard/Tunneling -->
    <uses-feature android:name="android.software.vpn" android:required="true" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="false"
        android:label="SuperVPN"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SuperVPN_Project"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity" />
        <activity android:name=".ServerSelectionActivity" />
        <activity android:name=".LanguageSelectionActivity" />
        <activity android:name=".PremiumActivity" />
        <activity android:name=".HelpSupportActivity" />
        <activity android:name=".AboutActivity" />
        <activity android:name=".UserProfileActivity" />
        <activity android:name=".SettingsActivity" />
        <activity android:name=".AccountActivity" />
        <activity android:name=".LoginActivity" />
        <activity android:name=".RegisterActivity" />
        <activity android:name=".AlwaysOnVpnActivity" />

        <!-- OpenVPN Service -->
        <service
            android:name="de.blinkt.openvpn.core.OpenVPNService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:process=":openvpn">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="vpn" />
        </service>

        <service
            android:name="de.blinkt.openvpn.core.keepVPNAlive"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true"/>

    </application>
</manifest>
