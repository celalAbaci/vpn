<?xml version="1.0" encoding="utf-8"?>
<!-- Bu dosya, PremiumActivity.java'daki kodlara göre yeniden oluşturuldu -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background"
    android:padding="16dp"
    tools:context=".PremiumActivity">

    <!-- Başlık ve Geri Butonu -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:scaleType="centerInside"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Premium'a Geçin"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Logo veya Premium İkonu -->
    <ImageView
        android:id="@+id/premiumIcon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_below="@id/header"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:src="@drawable/ic_crown"
        app:tint="@color/premium_yellow" />

    <TextView
        android:id="@+id/premiumTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/premiumIcon"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:text="Sınırsız Erişimin Keyfini Çıkarın"
        android:textColor="@android:color/white"
        android:textSize="18sp" />

    <!-- Planları içeren dikey LinearLayout -->
    <LinearLayout
        android:id="@+id/plansContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/premiumTitle"
        android:layout_marginTop="24dp"
        android:orientation="vertical">

        <!-- Haftalık Plan -->
        <RelativeLayout
            android:id="@+id/weeklyPlanLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_dark_gray_2"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvWeeklyPlanName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Haftalık Plan"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWeeklyDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvWeeklyPlanName"
                android:textColor="@color/gray_light"
                android:textSize="12sp"
                tools:text="5 Cihaz / 10GB Limit" />

            <TextView
                android:id="@+id/tvWeeklyPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:textColor="@color/premium_yellow"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="19.99 TL / hafta" />

            <Button
                android:id="@+id/btnBuyWeekly"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_below="@id/tvWeeklyDetails"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_rounded_gray_button"
                android:text="Satın Al"
                android:textColor="@color/gray_button_text" />
        </RelativeLayout>

        <!-- Aylık Plan -->
        <RelativeLayout
            android:id="@+id/monthlyPlanLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_yellow_active"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvMonthlyPlanName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aylık Plan"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvMonthlyDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvMonthlyPlanName"
                android:textColor="@color/gray_light"
                android:textSize="12sp"
                tools:text="5 Cihaz / 50GB Limit" />
            <TextView
                android:id="@+id/tvMonthlyPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:textColor="@color/premium_yellow"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="49.99 TL / ay" />
            <Button
                android:id="@+id/btnBuyMonthly"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_below="@id/tvMonthlyDetails"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_rounded_yellow_button"
                android:text="Satın Al"
                android:textColor="@color/button_text_color" />
        </RelativeLayout>

        <!-- Yıllık Plan -->
        <RelativeLayout
            android:id="@+id/yearlyPlanLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_dark_gray_2"
            android:padding="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvYearlyPlanName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yıllık Plan"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvYearlyDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvYearlyPlanName"
                android:textColor="@color/gray_light"
                android:textSize="12sp"
                tools:text="10 Cihaz / Sınırsız Limit" />
            <TextView
                android:id="@+id/tvYearlyPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:textColor="@color/premium_yellow"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="499.99 TL / yıl" />
            <Button
                android:id="@+id/btnBuyYearly"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_below="@id/tvYearlyDetails"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_rounded_gray_button"
                android:text="Satın Al"
                android:textColor="@color/gray_button_text" />
        </RelativeLayout>

    </LinearLayout>

    <!-- Yükleme Barı -->
    <ProgressBar
        android:id="@+id/loadingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone"
        android:indeterminateTint="@color/premium_yellow"
        tools:visibility="visible"/>


    <!-- Zaten Premium mu? Linki -->
    <TextView
        android:id="@+id/tvAlreadyPremium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:text="Zaten Premium'unuz var mı? Geri Yükleyin"
        android:textColor="@color/premium_yellow"
        android:textSize="14sp" />

</RelativeLayout>
